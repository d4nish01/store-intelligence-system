# .env.example
# Store Intelligence System — Environment Variable Template v1.1
# ─────────────────────────────────────────────────────────────
# Copy to .env and edit before running:
#   cp .env.example .env
#
# Do NOT commit .env to version control.
# All threshold values (queue_spike_depth, etc.) live in config/settings.yaml — not here.
# All store-specific values (cameras, windows) live in config/stores.yaml — not here.

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (file-based, zero setup, take-home portable)
# The file store_intelligence.db is created at project root by scripts/init_db.py
DATABASE_URL=sqlite:///./store_intelligence.db

# Production migration path (PostgreSQL):
# Uncomment and update the line below when deploying to a server.
# The schema in CONTRACT.md §8 is written to be compatible with both.
# DATABASE_URL=postgresql://si_user:si_password@localhost:5432/store_intelligence

# PostgreSQL credentials — only needed if switching DATABASE_URL to PostgreSQL above
# POSTGRES_USER=si_user
# POSTGRES_PASSWORD=si_password
# POSTGRES_DB=store_intelligence

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Application environment: development | production
APP_ENV=development

# Version string returned in GET /health response
APP_VERSION=1.0.0

# ── Config File Paths ─────────────────────────────────────────────────────────
# Paths are relative to the project root.
# These defaults are correct — only change if you have a non-standard layout.
STORES_CONFIG_PATH=config/stores.yaml
SETTINGS_CONFIG_PATH=config/settings.yaml

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: json | text
LOG_FORMAT=json

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Base directory for raw video files (used by pipeline/process_store.py)
# Individual store subdirectories are defined in config/stores.yaml → raw_dir
RAW_DATA_DIR=data/raw

# Directory where pipeline writes emitted JSONL event files
OUTPUT_EVENTS_DIR=output/events

# API URL used by pipeline/replay.py and pipeline/emit.py to POST events
INGEST_API_URL=http://localhost:8000/events/ingest

# ── Detection (AI-3 pipeline) ─────────────────────────────────────────────────
# Path to YOLO model weights (relative to project root)
# Download: https://github.com/ultralytics/ultralytics
YOLO_WEIGHTS_PATH=models/yolov8n.pt

# Compute device: -1 = CPU, 0 = first GPU, 1 = second GPU
DETECTION_DEVICE=0
